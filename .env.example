# ============================================================
# Variables de entorno — MiDiarioMascota
# Copiá este archivo a .env.local y completá los valores
# NUNCA commitees .env.local ni .env con valores reales
# ============================================================

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx

# Sentry (monitoreo de errores)
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxx@o0.ingest.sentry.io/0

# PostHog (analytics respetuosos)
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# OpenAI (solo para Edge Functions en backend — NUNCA exponer en cliente)
# Estas variables NO tienen prefijo EXPO_PUBLIC_
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Encriptación de transcripciones (Edge Functions)
TRANSCRIPT_ENCRYPTION_SECRET=cambia-esto-por-un-secreto-fuerte-de-32-chars
